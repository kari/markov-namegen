{
  "name": "@ksilvennoinen/markov-namegen",
  "version": "2.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "description": "Markov chain based name generator in TypeScript",
  "keywords": [
    "markov-chain",
    "procedural",
    "name-generator",
    "namegen",
    "random"
  ],
  "author": "Kari Silvennoinen",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/kari/markov-namegen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kari/markov-namegen.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist', '.tsbuildinfo', '.tsbuildinfo.test', 'tsconfig.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json --noEmit && tsx --test test/*.test.ts",
    "format": "biome format --write src test",
    "lint": "biome check src test",
    "prepack": "npm run build"
  },
  "files": [
    "dist/",
    "CHANGELOG.md"
  ]
}
